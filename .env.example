# ============================================
# 项目环境变量配置示例（请复制为 .env 使用）
# 本文件不会参与版本控制，仅供参考
# ============================================

# 【分组类规则】
# - 环境变量名称必须为 <PREFIX>_<INDEX>_<KEY> 格式
#   例如：MYSQL_1_HOST、MYSQL_2_PORT
# - PREFIX：表示配置用途（如 MYSQL、REDIS、API）
# - INDEX：从 1 开始递增的组编号，允许不连续
# - KEY：配置字段名，推荐使用大写，允许包含 -, a-z, A-Z, 0-9, _
# - 支持多组配置（如 MYSQL_1_XXX、MYSQL_2_XXX ...）
# - 每组必须包含所有指定字段，否则程序将报错退出

# ============================================
# 示例：MySQL 多组数据库连接配置
# 可用于程序中自动识别多个数据库实例
# ============================================

# 第 1 组 MySQL 配置
MYSQL_1_HOST=127.0.0.1
MYSQL_1_PORT=3306
MYSQL_1_USER=root
MYSQL_1_PASSWORD=changeme

# 第 2 组 MySQL 配置
MYSQL_2_HOST=192.168.10.20
MYSQL_2_PORT=3307
MYSQL_2_USER=admin
MYSQL_2_PASSWORD=adminpwd

# 第 3 组（可选）
# MYSQL_3_HOST=...

# ============================================
# 示例：其它服务（可扩展同样命名规范）
# ============================================

# REDIS_1_HOST=localhost
# REDIS_1_PORT=6379
# API_1_BASE_URL=https://api.example.com
# API_1_TOKEN=xxxxxx


# 【非分组类变量】
# ============================================
# 非组类变量示例（单一配置）
# ============================================

# 项目调试开关（true / false）
DEBUG=true

# 默认数据库名称（可被连接字符串使用）
MYSQL_DB=default_db
